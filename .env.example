# ───────── Firebase (Admin SDK — SERVEUR, SECRET) ─────────
# Option 1 (local) : placez serviceAccountKey.json à la racine (ignoré par Git).
# Option 2 : indiquez un autre chemin ici.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Option 3 (hébergement) : contenu JSON de la clé sur une seule ligne.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ───────── Firebase (SDK Web — navigateur, non secret) ─────────
# Console Firebase > Paramètres du projet > Vos applications > Configuration du SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ───────── Paiement Konnect (mode test) ─────────
KONNECT_API_KEY=
KONNECT_RECEIVER_WALLET_ID=

# Port du serveur (défaut 3000)
# PORT=3000
